<Project Sdk="Microsoft.NET.Sdk">
  <!-- Storage Inc (internal name PhysCoop), ported from the decompiled XNA 3.0 Xbox build to FNA. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StorageInc</AssemblyName>
    <RootNamespace>PhysCoop</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <ProjectReference Include="..\FarseerPhysics\FarseerPhysics.csproj" />
  </ItemGroup>
  <!-- Converted game content (tools/build_content.py -> build/Content, gitignored). -->
  <ItemGroup>
    <None Include="..\..\build\Content\**\*" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Reconstructed effects (tools/build_shaders.py compiles Shaders/*.fx to the committed *.fxb). -->
  <ItemGroup>
    <None Include="Shaders\Brightness.fxb" Link="Content\ScreenManagerResources\Brightness.fxb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Shaders\Deferred1Scene.fxb;Shaders\Deferred2Lights.fxb;Shaders\Deferred3Final.fxb;Shaders\ShadowMap.fxb" Link="Content\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- FNA native libraries for the target OS/CPU (fetched by tools/fetch_fnalibs.py, gitignored). -->
  <Import Project="..\..\FnaLibs.targets" />
</Project>
